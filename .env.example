# TRUTHOS Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

# Required for live web research & verification (ONLY external API permitted)
TAVILY_API_KEY=

# Application server & database
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/truthos.db

# PostgreSQL & Redis (used by Python FastAPI + Celery production deployment)
DATABASE_URL=postgresql+psycopg2://truthos:truthos_password@localhost:5432/truthos
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
SECRET_KEY=replace-with-strong-random-256-bit-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deployment URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
